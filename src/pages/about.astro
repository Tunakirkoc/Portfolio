---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import profileImg from "../assets/images/profile.jpg";
---

<BaseLayout
  title="À propos"
  description="Tuna Kirkoc — étudiant en administration système et réseaux, passionné d'infrastructure, de cybersécurité et d'homelab."
>
  <main class="min-h-screen bg-neutral-950 px-6 py-12 font-[Inter] text-white">
    <div class="mx-auto max-w-2xl">
      <a
        href="/"
        class="font-[JetBrains_Mono] text-sm text-neutral-500 transition-colors hover:text-neutral-200"
        >← accueil</a
      >

      <header class="mt-10 mb-12 flex flex-col items-start gap-8 sm:flex-row">
        <Image
          src={profileImg}
          alt="Portrait de Tuna Kirkoc"
          width={112}
          height={112}
          loading="eager"
          class="h-28 w-28 shrink-0 rounded-full border-2 border-neutral-800 object-cover"
        />
        <div>
          <p class="mb-1 font-[JetBrains_Mono] text-sm text-neutral-400">
            Tuna Kirkoc
          </p>
          <h1 class="text-4xl font-bold tracking-tight">À propos</h1>
          <p class="mt-3 leading-relaxed text-neutral-400">
            J'ai 22 ans et je recherche de nouvelles expériences
            professionnelles dans le domaine de l'IT. Curieux et passionné par
            les systèmes, les réseaux et l'infrastructure, j'aime monter en
            compétences sur le terrain comme en autonomie (homelab, veille,
            projets personnels).
          </p>
        </div>
      </header>

      <section class="mb-12">
        <h2
          class="mb-4 font-[JetBrains_Mono] text-xs tracking-widest text-neutral-500 uppercase"
        >
          Formation
        </h2>
        <ul class="space-y-5 border-l border-neutral-800 pl-5 text-sm">
          <li>
            <time class="font-[JetBrains_Mono] text-xs text-neutral-200"
              >depuis janv. 2024</time
            >
            <p class="mt-1 font-medium">
              Bac+4 — Administrateur système et réseau
            </p>
            <p class="mt-0.5 text-neutral-400">
              ENI École · en alternance chez Global Connect SAS (Angers)
            </p>
          </li>
          <li>
            <time class="font-[JetBrains_Mono] text-xs text-neutral-500"
              >sept. 2021 - juil. 2023</time
            >
            <p class="mt-1 font-medium">BTS SIO — option SISR (diplômé)</p>
            <p class="mt-0.5 text-neutral-400">
              Lycée Chevrollier · solutions d'infrastructure, systèmes et
              réseaux
            </p>
          </li>
          <li>
            <time class="font-[JetBrains_Mono] text-xs text-neutral-500"
              >sept. 2018 - juil. 2021</time
            >
            <p class="mt-1 font-medium">
              Bac Pro — systèmes numériques (diplômé)
            </p>
            <p class="mt-0.5 text-neutral-400">
              Lycée Chevrollier · option RISC (réseaux informatiques et systèmes
              communicants)
            </p>
          </li>
        </ul>
      </section>

      <section class="mb-12">
        <h2
          class="mb-4 font-[JetBrains_Mono] text-xs tracking-widest text-neutral-500 uppercase"
        >
          Expérience professionnelle
        </h2>
        <ul class="space-y-6 text-sm">
          <li class="border-b border-neutral-800/80 pb-6">
            <time class="font-[JetBrains_Mono] text-xs text-neutral-200"
              >janv. 2024 - aujourd'hui</time
            >
            <p class="mt-1 font-medium">
              Global Connect — administrateur système, réseau et télécom
            </p>
            <ul
              class="mt-2 list-inside list-disc space-y-1.5 leading-relaxed text-neutral-400"
            >
              <li>
                Support technique de niveaux 1 à 3 pour plus de 500 clients
                TPE/PME
              </li>
              <li>
                Conception et déploiement de solutions de cybersécurité
                (Stormshield, OPNsense)
              </li>
              <li>
                Déploiement et maintenance d'accès Internet professionnels (FTTO
                / FTTB, opérateur niveau 3)
              </li>
              <li>
                Installation et maintenance d'infrastructures réseau (Zyxel,
                Draytek) et de téléphonie (3CX)
              </li>
              <li>
                Mise en place d'un monitoring centralisé avec Grafana pour
                optimiser les diagnostics
              </li>
              <li>
                Migration d'outils collaboratifs (Microsoft 365 / Google
                Workspace, Dynamics 365 / HubSpot)
              </li>
            </ul>
          </li>
          <li class="border-b border-neutral-800/80 pb-6">
            <time class="font-[JetBrains_Mono] text-xs text-neutral-500"
              >mai - juil. 2022</time
            >
            <p class="mt-1 font-medium">
              ESEO Angers — technicien système et réseau
            </p>
            <ul
              class="mt-2 list-inside list-disc space-y-1.5 leading-relaxed text-neutral-400"
            >
              <li>
                Déploiement de parcs informatiques pour des laboratoires
                d'ingénierie (FOG Project)
              </li>
              <li>Maintenance d'infrastructures réseau Cisco</li>
              <li>Mise à niveau et gestion d'affichages numériques (Xibo)</li>
            </ul>
          </li>
          <li class="border-b border-neutral-800/80 pb-6">
            <time class="font-[JetBrains_Mono] text-xs text-neutral-500"
              >fév. - mars 2023</time
            >
            <p class="mt-1 font-medium">
              Vozit — technicien système et télécom
            </p>
            <ul
              class="mt-2 list-inside list-disc space-y-1.5 leading-relaxed text-neutral-400"
            >
              <li>Déploiement de serveurs SIP sous Asterisk</li>
              <li>Installation et gestion d'hyperviseurs Proxmox VE</li>
            </ul>
          </li>
          <li>
            <time class="font-[JetBrains_Mono] text-xs text-neutral-500"
              >janv. - mars 2021</time
            >
            <p class="mt-1 font-medium">
              Lalè Boutique — technicien système et réseau
            </p>
            <p class="mt-2 text-neutral-400">
              Création et déploiement d'un site e-commerce
            </p>
          </li>
        </ul>
      </section>

      <section class="mb-12">
        <h2
          class="mb-4 font-[JetBrains_Mono] text-xs tracking-widest text-neutral-500 uppercase"
        >
          Compétences techniques
        </h2>
        <dl class="space-y-4 text-sm">
          <div>
            <dt class="mb-1 font-[JetBrains_Mono] text-xs text-neutral-500">
              Environnements
            </dt>
            <dd class="leading-relaxed text-neutral-300">
              Windows (Server, Core), Unix/Linux (Debian, Arch, FreeBSD), macOS
            </dd>
          </div>
          <div>
            <dt class="mb-1 font-[JetBrains_Mono] text-xs text-neutral-500">
              Virtualisation
            </dt>
            <dd class="leading-relaxed text-neutral-300">
              Proxmox, Hyper-V, VMware, XCP-ng et Xen Orchestra
            </dd>
          </div>
          <div>
            <dt class="mb-1 font-[JetBrains_Mono] text-xs text-neutral-500">
              Infrastructure &amp; sécurité
            </dt>
            <dd class="leading-relaxed text-neutral-300">
              Stormshield, Cisco, Ubiquiti, Zyxel, OPNsense, OpenWrt
            </dd>
          </div>
          <div>
            <dt class="mb-1 font-[JetBrains_Mono] text-xs text-neutral-500">
              Applications &amp; services
            </dt>
            <dd class="leading-relaxed text-neutral-300">
              Annuaires (Active Directory, Entra ID, Google Workspace,
              OpenLDAP), IAM (Keycloak, SAML, OpenID Connect, OAuth), exposition
              web (NGINX, Traefik)
            </dd>
          </div>
          <div>
            <dt class="mb-1 font-[JetBrains_Mono] text-xs text-neutral-500">
              Développement
            </dt>
            <dd class="leading-relaxed text-neutral-300">
              Python, Shell, PowerShell, HTML/CSS, JavaScript (React,
              TypeScript)
            </dd>
          </div>
          <div>
            <dt class="mb-1 font-[JetBrains_Mono] text-xs text-neutral-500">
              Conteneurisation &amp; orchestration
            </dt>
            <dd class="leading-relaxed text-neutral-300">
              Docker, Kubernetes (Talos Linux, Rancher RKE2, K3s)
            </dd>
          </div>
        </dl>
      </section>

      <section class="mb-12">
        <h2
          class="mb-4 font-[JetBrains_Mono] text-xs tracking-widest text-neutral-500 uppercase"
        >
          Certifications &amp; langues
        </h2>
        <ul class="space-y-2 text-sm text-neutral-300">
          <li>CCNA 1, 2 et 3</li>
          <li>Certification Stormshield Network Administrator (CSNA)</li>
          <li>
            <span class="text-neutral-500">Langues :</span> français (langue maternelle),
            anglais (C2 — expérimenté)
          </li>
        </ul>
      </section>

      <section class="mb-12">
        <h2
          class="mb-4 font-[JetBrains_Mono] text-xs tracking-widest text-neutral-500 uppercase"
        >
          Centres d'intérêt
        </h2>
        <p class="text-sm leading-relaxed text-neutral-400">
          Homelab (hébergement local, expérimentation sur l'infrastructure et
          les systèmes) · portfolio personnel · cinématographie et photographie
          · fabrication électronique (IoT, drone FPV) et impression 3D · VTT /
          bikepacking
        </p>
      </section>

      <section>
        <h2
          class="mb-4 font-[JetBrains_Mono] text-xs tracking-widest text-neutral-500 uppercase"
        >
          Contact
        </h2>
        <ul class="space-y-2 font-[JetBrains_Mono] text-sm">
          <li>
            <a
              href="mailto:tuna@kirkoc.fr"
              class="text-neutral-400 underline-offset-2 transition-colors hover:text-neutral-100 hover:underline"
              >tuna@kirkoc.fr</a
            >
          </li>
          <li>
            <a
              href="https://tuna.kirkoc.fr"
              class="text-neutral-400 underline-offset-2 transition-colors hover:text-neutral-100 hover:underline"
              >tuna.kirkoc.fr</a
            >
          </li>
          <li class="pt-1 text-neutral-500">Réseaux : @Tunakirkoc</li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
