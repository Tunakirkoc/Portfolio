---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import profileImg from "../assets/images/profile.jpg";
import DotGrid from "../components/DotGrid";
---

<BaseLayout
  title={"Home"}
  description={"Welcome to Tuna Kirkoc's personal website. Explore my projects, thoughts, and more."}
>
  <main
    class="relative flex min-h-screen flex-col bg-neutral-950 font-[Inter] text-white"
  >
    <!-- Hero -->
    <section class="relative flex items-center justify-center px-8 py-8">
      <div class="absolute inset-0 z-0 bg-neutral-950"></div>
      <div class="absolute inset-0 z-[1]">
        <DotGrid client:load />
      </div>
      <a
        href="/about"
        aria-label="À propos"
        class="group relative z-[2] -mx-3 -my-2 flex items-center gap-5 rounded-2xl px-3 py-2 outline-offset-4 transition-colors hover:bg-white/[0.03] focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-500/60"
      >
        <Image
          src={profileImg}
          alt=""
          width={80}
          height={80}
          loading="eager"
          class="h-20 w-20 shrink-0 rounded-full border-2 border-neutral-800 object-cover transition-[border-color,box-shadow]"
        />
        <div>
          <h1 class="text-xl font-bold tracking-tight">Tuna</h1>
          <p class="mt-0.5 text-sm text-neutral-400">IT Student</p>
          <p class="mt-1 text-xs text-neutral-500 italic">
            "Explore. Dream. Discover." - Unknown
          </p>
        </div>
      </a>
    </section>

    <!-- Split: Labs | Lens -->
    <section class="relative z-10 flex min-h-0 flex-1 flex-col md:flex-row">
      <!-- Labs -->
      <a
        href="/labs"
        class="group relative flex flex-1 items-center justify-center overflow-hidden transition-all duration-500 md:hover:flex-[1.6]"
      >
        <div
          class="absolute inset-0 bg-gradient-to-br from-emerald-950/50 via-neutral-900/80 to-neutral-950 transition-all duration-500 group-hover:from-emerald-900/60"
        >
        </div>
        <div
          class="absolute inset-0 border-b border-neutral-800/40 md:border-r md:border-b-0"
        >
        </div>
        <div class="relative z-10 px-8 text-center">
          <h2
            class="text-5xl font-bold tracking-tighter text-white/85 transition-colors duration-300 group-hover:text-white md:text-7xl"
          >
            Labs
          </h2>
          <p
            class="mt-3 text-sm text-neutral-500 transition-colors duration-300 group-hover:text-neutral-300"
          >
            Explore my latest experiments and projects.
          </p>
          <span
            class="mt-5 inline-flex items-center gap-2 text-sm text-emerald-500 transition-all duration-300 group-hover:gap-3 group-hover:text-emerald-400"
          >
            <span>Explore</span>
            <span
              class="transition-transform duration-300 group-hover:translate-x-1"
              >→</span
            >
          </span>
        </div>
      </a>

      <!-- Lens (disabled) -->
      <div
        class="group relative flex flex-1 items-center justify-center overflow-hidden transition-all duration-500 md:hover:flex-[1.6]"
      >
        <div
          class="absolute inset-0 bg-gradient-to-bl from-purple-950/50 via-neutral-900/80 to-neutral-950 transition-all duration-500 group-hover:from-purple-900/60"
        >
        </div>
        <div class="relative z-10 px-8 text-center">
          <h2
            class="text-5xl font-bold tracking-tighter text-white/85 transition-colors duration-300 group-hover:text-white md:text-7xl"
          >
            Lens
          </h2>
          <p
            class="mt-3 text-sm text-neutral-500 transition-colors duration-300 group-hover:text-neutral-300"
          >
            Soon™
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
