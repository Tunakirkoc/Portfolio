---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Lens"
  description="Cinematography, photography, and creative work by Tuna Kirkoc."
>
  <main
    class="flex min-h-screen flex-col items-center justify-center bg-neutral-950 px-6 font-[Inter] text-white"
  >
    <a
      href="/"
      class="absolute top-6 left-6 font-[JetBrains_Mono] text-sm text-neutral-500 transition-colors hover:text-purple-400"
      >← home</a
    >
    <div class="text-center">
      <h1 class="text-5xl font-bold tracking-tight text-white/85">Lens</h1>
      <p class="mt-4 text-neutral-500">Coming soon.</p>
    </div>
  </main>
</BaseLayout>
