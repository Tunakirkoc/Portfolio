---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist.">
  <main class="min-h-screen bg-neutral-950 text-white flex flex-col items-center justify-center px-6 font-[Inter]">
    <a href="/" class="absolute top-6 left-6 text-neutral-500 hover:text-emerald-400 text-sm transition-colors font-[JetBrains_Mono]">← home</a>
    <div class="text-center max-w-md">
      <p class="text-neutral-500 font-[JetBrains_Mono] text-sm mb-4">404</p>
      <h1 class="text-3xl font-bold tracking-tight">Page not found</h1>
      <p class="text-neutral-500 mt-3 text-sm">This URL does not exist or has been moved.</p>
    </div>
  </main>
</BaseLayout>
