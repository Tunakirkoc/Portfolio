---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for does not exist."
>
  <main
    class="flex min-h-screen flex-col items-center justify-center bg-neutral-950 px-6 font-[Inter] text-white"
  >
    <a
      href="/"
      class="absolute top-6 left-6 font-[JetBrains_Mono] text-sm text-neutral-500 transition-colors hover:text-emerald-400"
      >← home</a
    >
    <div class="max-w-md text-center">
      <p class="mb-4 font-[JetBrains_Mono] text-sm text-neutral-500">404</p>
      <h1 class="text-3xl font-bold tracking-tight">Page not found</h1>
      <p class="mt-3 text-sm text-neutral-500">
        This URL does not exist or has been moved.
      </p>
    </div>
  </main>
</BaseLayout>
