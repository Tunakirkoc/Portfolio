---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LabsPostCard from "../../components/LabsPostCard.astro";

const posts = (await getCollection("labs"))
  .filter((p) => !p.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );
---

<BaseLayout
  title="Labs"
  description="IT projects, homelab experiments, and engineering write-ups by Tuna Kirkoc."
>
  <main class="min-h-screen bg-neutral-950 px-6 py-12 text-white">
    <div class="mx-auto max-w-2xl">
      <a
        href="/"
        class="font-[JetBrains_Mono] text-sm text-neutral-500 transition-colors hover:text-emerald-400"
        >← home</a
      >

      <div class="mt-10 mb-10">
        <p class="mb-2 font-[JetBrains_Mono] text-sm text-neutral-400">
          Tuna Kirkoc
        </p>
        <h1 class="font-[Inter] text-4xl font-bold tracking-tight">Labs</h1>
        <p class="mt-2 font-[Inter] text-sm text-neutral-400">
          Homelab, IT projects, and engineering experiments.
        </p>
      </div>

      {
        posts.length === 0 ? (
          <p class="font-[JetBrains_Mono] text-sm text-neutral-600">
            // no posts yet
          </p>
        ) : (
          <ul class="space-y-4">
            {posts.map((post) => (
              <li>
                <LabsPostCard id={post.id.replace(/\.mdx?$/, "")} />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </main>
</BaseLayout>
