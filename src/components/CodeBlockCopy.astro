<div data-code-copy-root>
  <slot />
</div>

<script>
  // Comment markers to skip when copying code-style blocks.
  const commentPrefixes: Record<string, string[]> = {
    bash: ["#"],
    sh: ["#"],
    shell: ["#"],
    zsh: ["#"],
    fish: ["#"],
    dockerfile: ["#"],
    makefile: ["#"],
    python: ["#"],
    py: ["#"],
    yaml: ["#"],
    yml: ["#"],
    sql: ["--"],
    html: ["<!--"],
    css: ["/*", "*"],
    js: ["//"],
    jsx: ["//"],
    ts: ["//"],
    tsx: ["//"],
    json: ["//"],
    ini: ["#", ";"],
  };

  // Strip comment-only lines so shell commands are easier to paste and run.
  const cleanCodeForCopy = (text: string, language: string) => {
    const prefixes = commentPrefixes[language] ?? ["#", "//", "--", ";", "/*", "<!--"];

    return text
      .split("\n")
      .filter((line) => {
        const trimmed = line.trim();
        if (trimmed === "") return false;
        return !prefixes.some((prefix) => trimmed.startsWith(prefix));
      })
      .join("\n")
      .trim();
  };

  // Copy the cleaned code to the clipboard and give quick UI feedback.
  const copyBlock = async (button: HTMLButtonElement, code: HTMLElement) => {
    const language = [...code.classList]
      .find((className) => className.startsWith("language-"))
      ?.replace("language-", "")
      .toLowerCase()
      ?? "";
    const cleaned = cleanCodeForCopy(code.textContent ?? "", language);

    try {
      await navigator.clipboard.writeText(cleaned);
      const previousLabel = button.textContent;
      button.textContent = "Copied";
      button.setAttribute("aria-label", "Copied code to clipboard");
      window.setTimeout(() => {
        button.textContent = previousLabel;
        button.setAttribute("aria-label", "Copy code to clipboard");
      }, 1600);
    } catch {
      button.textContent = "Copy failed";
      window.setTimeout(() => {
        button.textContent = "Copy";
      }, 1600);
    }
  };

  // Add one copy button per rendered code block.
  const root = document.querySelector<HTMLElement>("[data-code-copy-root]");
  root?.querySelectorAll("pre").forEach((pre) => {
    const code = pre.querySelector("code");
    if (!code || pre.parentElement?.dataset.copyWrapper === "true") return;

    const wrapper = document.createElement("div");
    wrapper.dataset.copyWrapper = "true";
    wrapper.className = "group relative my-6";

    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);

    const button = document.createElement("button");
    button.type = "button";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy code to clipboard");
    button.className =
      "absolute right-3 top-3 rounded border border-neutral-700 bg-neutral-950/90 px-2.5 py-1 font-[JetBrains_Mono] text-[11px] text-neutral-300 opacity-0 transition hover:border-neutral-500 hover:text-white group-hover:opacity-100 focus:opacity-100";
    button.addEventListener("click", () => copyBlock(button, code as HTMLElement));

    wrapper.appendChild(button);
  });
</script>